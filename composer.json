{
    "name": "moneyapp/moneyapp",
    "description": "Gerenciador de finanças pessoais (PHP 8.2+ puro + SQLite). Inspirado no Microsoft Money.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Moneyapp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moneyapp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
